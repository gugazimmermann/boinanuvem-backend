  supplierId          String?
  buyerId             String?
  paymentDate         DateTime?
  referenceNumber     String?
  linkedSaleId        String?
  linkedAcquisitionId String?
  observation         String?
  deletedAt           DateTime? // Soft delete timestamp
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

