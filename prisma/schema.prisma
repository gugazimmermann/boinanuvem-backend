  buyer           Buyer?           @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  sale            Sale?            @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)
  acquisition     Acquisition?     @relation(fields: [linkedAcquisitionId], references: [id], onDelete: SetNull)
  observations    CashFlowObservation[]

  @@index([companyId])
  @@index([propertyId])
  @@index([deletedAt])
  @@map("cash_flows")
}

