// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  monthlyPrice String
  annualPrice  String
  limits       Json     // Store limits as JSON: {properties, locations, animals, members}
  features     String[] // Array of feature strings
  popular      Boolean  @default(false)
  status       String   @default("active") // "active" or "inactive"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  subscriptions CompanySubscription[]

  @@map("plans")
}

model Company {
  id           String   @id @default(cuid())
  cnpj         String   @unique
  companyName  String
  email        String   @unique
  phone        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float?
  longitude    Float?
  status       String   @default("active") // "active" or "inactive"
  trialStartDate DateTime? // When trial period started
  trialEndDate   DateTime? // When trial period ends
  trialStatus    String?   @default("active") // "active", "expired", "converted"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users         User[]
  subscriptions CompanySubscription[]
  payments      CompanyPayment[]
  properties    Property[]
  locations     Location[]
  employees     Employee[]
  serviceProviders ServiceProvider[]
  suppliers     Supplier[]
  buyers        Buyer[]

  @@map("companies")
}

model User {
  id           String   @id @default(cuid())
  name         String
  cpf          String?
  email        String   @unique
  phone        String
  password     String
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  mainUser     Boolean  @default(false)
  status       String   @default("pending") // "pending", "active", "inactive"
  permissions  Json?    // Store permissions as JSON
  lastAccess   DateTime?
  emailVerifiedAt DateTime?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  rememberMe Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model CompanySubscription {
  id          String   @id @default(cuid())
  companyId   String
  planId      String
  status      String   @default("active") // "active", "cancelled", "expired", "trial"
  startDate   DateTime @default(now())
  endDate     DateTime?
  billingCycle String  @default("monthly") // "monthly", "annual"
  isActive    Boolean  @default(true)
  isTrial     Boolean  @default(false)
  trialEndDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [planId], references: [id])
  payments    CompanyPayment[]

  @@map("company_subscriptions")
}

model CompanyPayment {
  id             String   @id @default(cuid())
  companyId      String
  subscriptionId String?
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("BRL")
  status         String   @default("pending") // "pending", "paid", "failed", "refunded", "cancelled"
  paymentMethod  String?  // "credit_card", "pix", "bank_transfer", "boleto"
  paymentDate    DateTime?
  dueDate        DateTime
  description    String?
  externalId     String?  // External payment gateway ID
  metadata       Json?    // Additional payment metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   CompanySubscription? @relation(fields: [subscriptionId], references: [id])

  @@map("company_payments")
}

model Property {
  id                            String   @id @default(cuid())
  code                          String
  name                          String
  area                          Json     // Store area as JSON: { value: number, type: string }
  status                        String   @default("active") // "active" or "inactive"
  companyId                     String
  street                        String
  number                        String
  complement                    String?
  neighborhood                  String
  city                          String
  state                         String
  zipCode                       String
  latitude                      Float?
  longitude                     Float?
  pasturePlanning               Json?    // Store pasture planning as JSON array
  breedingMonths                Json?    // Store breeding months as JSON array
  pasturePlanningModifiedByUser Boolean  @default(false)
  breedingSeasonModifiedByUser  Boolean  @default(false)
  deletedAt                     DateTime? // Soft delete timestamp
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  // Relations
  company                       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations                     Location[]
  employeeProperties            EmployeeProperty[]
  serviceProviderProperties     ServiceProviderProperty[]
  supplierProperties            SupplierProperty[]
  buyerProperties               BuyerProperty[]

  @@unique([companyId, code], name: "unique_property_code_per_company")
  @@index([companyId])
  @@index([deletedAt])
  @@map("properties")
}

model Location {
  id            String   @id @default(cuid())
  code          String
  name          String
  locationType  String   // pasture, barn, storage, corral, silo, field, paddock, feedlot, semi_feedlot, milking_parlor, warehouse, garage, office, residence, other
  area          Json     // Store area as JSON: { value: number, type: string }
  status        String   @default("active") // "active" or "inactive"
  companyId     String
  propertyId    String
  deletedAt     DateTime? // Soft delete timestamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([companyId, propertyId, code], name: "unique_location_code_per_company_property")
  @@index([companyId])
  @@index([propertyId])
  @@index([deletedAt])
  @@map("locations")
}

model Employee {
  id            String   @id @default(cuid())
  code          String
  name          String
  cpf           String?
  email         String?
  phone         String?
  status        String   @default("active") // "active" or "inactive"
  companyId     String
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  deletedAt     DateTime? // Soft delete timestamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties    EmployeeProperty[]

  @@unique([companyId, code], name: "unique_employee_code_per_company")
  @@index([companyId])
  @@index([deletedAt])
  @@map("employees")
}

model EmployeeProperty {
  id         String   @id @default(cuid())
  employeeId String
  propertyId String
  createdAt  DateTime @default(now())

  // Relations
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, propertyId], name: "unique_employee_property")
  @@index([employeeId])
  @@index([propertyId])
  @@map("employee_properties")
}

model ServiceProvider {
  id            String   @id @default(cuid())
  code          String
  name          String
  cpf           String?
  cnpj          String?
  email         String?
  phone         String?
  status        String   @default("active") // "active" or "inactive"
  companyId     String
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  deletedAt     DateTime? // Soft delete timestamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties    ServiceProviderProperty[]

  @@unique([companyId, code], name: "unique_service_provider_code_per_company")
  @@index([companyId])
  @@index([deletedAt])
  @@map("service_providers")
}

model ServiceProviderProperty {
  id              String   @id @default(cuid())
  serviceProviderId String
  propertyId      String
  createdAt       DateTime @default(now())

  // Relations
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([serviceProviderId, propertyId], name: "unique_service_provider_property")
  @@index([serviceProviderId])
  @@index([propertyId])
  @@map("service_provider_properties")
}

model Supplier {
  id            String   @id @default(cuid())
  code          String
  name          String
  cpf           String?
  cnpj          String?
  email         String?
  phone         String?
  status        String   @default("active") // "active" or "inactive"
  companyId     String
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  deletedAt     DateTime? // Soft delete timestamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties    SupplierProperty[]

  @@unique([companyId, code], name: "unique_supplier_code_per_company")
  @@index([companyId])
  @@index([deletedAt])
  @@map("suppliers")
}

model SupplierProperty {
  id         String   @id @default(cuid())
  supplierId String
  propertyId String
  createdAt  DateTime @default(now())

  // Relations
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([supplierId, propertyId], name: "unique_supplier_property")
  @@index([supplierId])
  @@index([propertyId])
  @@map("supplier_properties")
}

model Buyer {
  id            String   @id @default(cuid())
  code          String
  name          String
  cpf           String?
  cnpj          String?
  email         String?
  phone         String?
  status        String   @default("active") // "active" or "inactive"
  companyId     String
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  deletedAt     DateTime? // Soft delete timestamp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties    BuyerProperty[]

  @@unique([companyId, code], name: "unique_buyer_code_per_company")
  @@index([companyId])
  @@index([deletedAt])
  @@map("buyers")
}

model BuyerProperty {
  id         String   @id @default(cuid())
  buyerId    String
  propertyId String
  createdAt  DateTime @default(now())

  // Relations
  buyer      Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([buyerId, propertyId], name: "unique_buyer_property")
  @@index([buyerId])
  @@index([propertyId])
  @@map("buyer_properties")
}
