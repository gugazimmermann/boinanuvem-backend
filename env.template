# =================================
# DATABASE CONFIGURATION
# =================================
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boinanuvem"

# For testing (optional)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boinanuvem_test"

# =================================
# APPLICATION CONFIGURATION
# =================================
# Environment: development, production, test
NODE_ENV=development

# Server port
PORT=3000

# API prefix for all routes (e.g., /api/plans)
API_PREFIX=api

# =================================
# SECURITY CONFIGURATION
# =================================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting configuration
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# IP blacklisting (comma-separated list of IPs to block)
# Example: BLACKLISTED_IPS=192.168.1.100,10.0.0.5,203.0.113.0
BLACKLISTED_IPS=

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Maximum request body size
MAX_REQUEST_SIZE=10mb

# =================================
# AUTHENTICATION CONFIGURATION
# =================================
# JWT secret key for signing tokens (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL for email verification links
# Development: http://localhost:5173
# Production: https://www.boinanuvem.com.br
FRONTEND_URL=http://localhost:5173

# =================================
# SWAGGER/API DOCUMENTATION
# =================================
# Enable Swagger documentation (true/false)
ENABLE_SWAGGER=true

# =================================
# LOGGING CONFIGURATION
# =================================
# Log level: error, warn, log, debug, verbose
LOG_LEVEL=debug

# Enable file logging (true/false)
LOG_FILE_ENABLED=true

# =================================
# SECURITY HEADERS
# =================================
# HSTS max age in seconds (31536000 = 1 year)
HSTS_MAX_AGE=31536000

# Content Security Policy directives
CSP_DIRECTIVES=default-src 'self'

# =================================
# DEVELOPMENT/PRODUCTION NOTES
# =================================
# For production, consider:
# - NODE_ENV=production
# - ENABLE_SWAGGER=false
# - LOG_LEVEL=warn
# - Use strong database credentials
# - Configure proper CORS_ORIGIN
# - Use HTTPS URLs where applicable

# Nodemailer
GMAIL_PASSWORD=
GMAIL_EMAIL=boinanuvem@gmail.com

# =================================
# STRIPE CONFIGURATION
# =================================
# Stripe secret key (test mode)
STRIPE_SECRET_KEY=

# Stripe webhook secret (set after creating webhook endpoint in Stripe dashboard)
# Get this from: Stripe Dashboard > Developers > Webhooks > Your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# SonarQube Configuration Template
# Copy this file to .env.local or add these variables to your existing .env file

# SonarQube Server Configuration
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# Project Configuration
SONAR_PROJECT_KEY=boinanuvem
SONAR_PROJECT_NAME=boinanuvem
SONAR_PROJECT_VERSION=0.0.1

# Token-based authentication (recommended)
# Token "boinanuvem" generated in SonarQube UI: Administration > Security > Users > Tokens
# SONAR_TOKEN=<your_sonar_token_here>

# Quality Gate Configuration
SONAR_QUALITYGATE_WAIT=true

# Skip SonarQube analysis (for emergency pushes)
# SKIP_SONAR=true
